# ============================================================
# TruePeopleSearch 本地部署环境配置模版
# 复制此文件为 .env 即可生效自定义配置
# ============================================================

# --- 数据库配置 (TiDB / MySQL) ---
TPS_DB_HOST=127.0.0.1
TPS_DB_PORT=4000
TPS_DB_USER=root
TPS_DB_PASSWORD=
TPS_DB_NAME=people_search

# --- Redis 消息队列配置 ---
TPS_REDIS_HOST=127.0.0.1
TPS_REDIS_PORT=6379

# --- 可视化面板 Web 服务配置 ---
TPS_DASHBOARD_HOST=127.0.0.1
TPS_DASHBOARD_PORT=5001

# --- 远程更新检测地址 (可选，支持私有服务器或 Gitee/GitHub 静态 JSON) ---
# TPS_UPDATE_CHECK_URL=https://gitee.com/your-org/people-search/raw/main/version.json

# --- 外部通知告警 Webhook (支持飞书、钉钉、企业微信) ---
# TPS_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxx
# TPS_ALERT_PLATFORM=feishu

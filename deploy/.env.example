# ============================================================
# TruePeopleSearch 本地部署环境配置模版
# 复制此文件为发布目录根部的 .env；客户启动器只读取下列本机依赖与面板端口。
# 进程环境变量优先于 .env。不要把凭据或代理、更新、Webhook、任务控制参数写入此文件。
# ============================================================

# --- 数据库配置 (TiDB / MySQL) ---
TPS_DB_HOST=127.0.0.1
TPS_DB_PORT=4000
TPS_DB_USER=root
TPS_DB_PASSWORD=
TPS_DB_NAME=people_search

# --- Redis 消息队列配置 ---
TPS_REDIS_HOST=127.0.0.1
TPS_REDIS_PORT=6379

# --- 可视化面板 Web 服务配置 ---
# 客户版本固定仅绑定 127.0.0.1；只能配置端口。
TPS_DASHBOARD_PORT=5001

# 客户安全模式、启动令牌、在线更新、Webhook、代理和任务控制项只可由受控启动器设置，
# .env 中的同名值会被忽略。

# Generated runtime.env lives at D:/TruePeopleSearch/config/runtime.env.
# It is installation state and MUST NOT be committed or placed in a bundle.
TPS_INSTALL_ROOT=D:/TruePeopleSearch
TPS_DB_HOST=127.0.0.1
TPS_DB_PORT=3306
TPS_DB_NAME=people_search
TPS_DB_USER=tps_app
TPS_DB_PASSWORD=GENERATED_LOCALLY
TPS_MYSQL_ROOT_PASSWORD=GENERATED_LOCALLY
TPS_REDIS_HOST=127.0.0.1
TPS_REDIS_PORT=6379
TPS_REDIS_PASSWORD=GENERATED_LOCALLY
TPS_DASHBOARD_PORT=5001
TPS_TIMEZONE=Asia/Shanghai
PLAYWRIGHT_BROWSERS_PATH=D:/TruePeopleSearch/runtime/ms-playwright
# Optional collection keys. Uncomment and fill locally to enable Start-Collector.ps1.
# Proxy credentials are installation state and MUST never enter a release archive.
# At least one proxy source is required before collection can start.
#CLOUDBYPASS_PROXY=http://127.0.0.1:5018
#PROXY_TUNNEL=
#PROXY_FILE=
# Worker concurrency for customer collection (1-8, default 4).
#TPS_CONCURRENCY=4

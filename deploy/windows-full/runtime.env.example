# Generated runtime.env lives at D:/TruePeopleSearch/config/runtime.env.
# It is installation state and MUST NOT be committed or placed in a bundle.
TPS_INSTALL_ROOT=D:/TruePeopleSearch
TPS_DB_HOST=127.0.0.1
TPS_DB_PORT=3306
TPS_DB_NAME=people_search
TPS_DB_USER=tps_app
TPS_DB_PASSWORD=GENERATED_LOCALLY
TPS_MYSQL_ROOT_PASSWORD=GENERATED_LOCALLY
TPS_REDIS_HOST=127.0.0.1
TPS_REDIS_PORT=6379
TPS_REDIS_PASSWORD=GENERATED_LOCALLY
TPS_DASHBOARD_PORT=5001
TPS_TIMEZONE=Asia/Shanghai
PLAYWRIGHT_BROWSERS_PATH=D:/TruePeopleSearch/runtime/ms-playwright
# Optional collection keys. Uncomment and fill locally to enable Start-Collector.ps1.
# Proxy credentials are installation state and MUST never enter a release archive.
# At least one proxy source is required before collection can start.
#CLOUDBYPASS_PROXY=http://127.0.0.1:5018
#PROXY_TUNNEL=
#PROXY_FILE=
# Upstream provider API that returns fresh exits (pulled at worker startup,
# merged periodically; response may be plain text lines or JSON).
#PROXY_API_URL=
# Refresh interval in seconds for upstream exits (minimum 120, default 600).
#PROXY_API_REFRESH_SEC=600
# Worker concurrency for customer collection (1-64, default 4).
# Values above 8 are high-throughput mode: size them from host CPU/RAM first.
#TPS_CONCURRENCY=4
# Cloudflare strategy: USE_CLOUDBYPASS=0 skips the gateway. TPS_OWN_CF=1 turns
# the browser off entirely: clearance cookies come from TPS_CF_SOLVER and pages
# are fetched over curl_cffi on the same proxy. The worker refuses to start with
# TPS_OWN_CF=1 and no TPS_CF_SOLVER.
#   module:callable      Python function solve(url, proxy, user_agent, timeout)
#   http://host:port/x   POST JSON {url, proxy, user_agent, timeout}
#   cmd:D:\tools\cf.exe  stdin JSON -> stdout JSON
# Reply: {"cookies": {...}, "user_agent": "...", "html": optional}
#USE_CLOUDBYPASS=1
#TPS_OWN_CF=0
#TPS_CF_SOLVER=
#TPS_CF_SOLVER_TIMEOUT=45
# Force a curl_cffi TLS target (default: picked from the solver's Chrome UA).
#TPS_IMPERSONATE=
# Pacing overrides (defaults shown). TPS_CLAIM_GAP_SEC grows automatically
# under rate limiting; TPS_IP_REST_SEC is per-exit cooldown after HTTP 429.
#TPS_CLAIM_GAP_SEC=3
#TPS_IP_REST_SEC=4200
#TPS_SESSION_RECYCLE=120
#TPS_FP_REST_SEC=45
#TPS_LANE_WARM_SEC=15
